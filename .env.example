# Copie para .env.local (e configure os mesmos valores na Vercel).
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO, com dados fictícios.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role). Só no servidor. Nunca faça commit dela.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: endereço público do site, usado nos links pessoais.
# NEXT_PUBLIC_SITE_URL=https://bolao.exemplo.com

# Opcional: schema do Postgres com as tabelas do bolão (padrão: bolao).
# SUPABASE_DB_SCHEMA=bolao
